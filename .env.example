# OpenTelemetry Configuration for Kubiks
# Copy this file to .env.local and add your actual Kubiks API key

# Kubiks OTLP Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.kubiks.app

# OTLP Protocol (HTTP with Protocol Buffers)
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Kubiks authentication header with your API key
# Get your API key from https://app.kubiks.ai
OTEL_EXPORTER_OTLP_HEADERS=x-kubiks-key=YOUR_KUBIKS_API_KEY_HERE

# Service Configuration
OTEL_SERVICE_NAME=chasebank
